<?php
require 'vendor/autoload.php';
require 'config/bootstrap.php';

use Mns\Buggy\Core\MySqlConnector;

echo "=== Hashage des mots de passe en clair ===\n\n";

$pdo = MySqlConnector::getInstance()->getConnection();

// Récupérer tous les utilisateurs
$stmt = $pdo->query("SELECT id, email, password FROM mns_user");
$users = $stmt->fetchAll(PDO::FETCH_ASSOC);

$updated = 0;
$skipped = 0;

foreach ($users as $user) {
    // Vérifier si le mot de passe est déjà hashé (bcrypt commence par $2y$, $2a$ ou $2b$)
    if (preg_match('/^\$2[ayb]\$/', $user['password'])) {
        echo "SKIP: {$user['email']} - mot de passe déjà hashé\n";
        $skipped++;
        continue;
    }

    // Hasher le mot de passe en clair
    $hashedPassword = password_hash($user['password'], PASSWORD_BCRYPT);

    // Mettre à jour en base
    $updateStmt = $pdo->prepare("UPDATE mns_user SET password = :password WHERE id = :id");
    $updateStmt->execute([
        'password' => $hashedPassword,
        'id' => $user['id']
    ]);

    echo "OK: {$user['email']} - mot de passe hashé avec succès\n";
    $updated++;
}

echo "\n=== Résumé ===\n";
echo "Mis à jour: $updated\n";
echo "Ignorés (déjà hashés): $skipped\n";
